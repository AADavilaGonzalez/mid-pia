I32_MAX: i32 = 2,147,483,647;
I32_MIN: i32 = -2,147,483,648;

fn usize_to_str(x: usize, buff: []u8) -> []u8 {
    if buff.len == 0 { return buff; }

    buff[0] = '0';

    aux: [20]u8; i: usize = 0;
    loop {
    if x == 0 || i >= buff.len { break; }
        mod := (x % 10) as u8;
        aux[i] = mod + '0';
    x /= 10; i += 1;
    }

    len := i; i = 0;
    loop {
    if i == end { break; }
        buff[i] = aux[len-1-i];
    i += 1;
    }

    return buff[..len];
}

fn i32_to_str(x: i32, buff: []u8) -> []u8 {
    if buff.len == 0 { return buff; }
    if x < 0 {
        buff[0] = '-';
        u: usize;
        if x == I32_MIN {
            u = I32_MAX as usize + 1;
        } else {
            u = -x as usize;
        }
        digits := usize_to_str(u, buff[1..]);
        return buff[..digits.len + 1];
    } else {
        return usize_to_str(x as usize, buff);
    }
}

fn main() {
    buff: [32]byte;
    x := 2 + 2;
    print("2 + 2 is: ");
    print(i32_to_str(buff[..], x));
}
